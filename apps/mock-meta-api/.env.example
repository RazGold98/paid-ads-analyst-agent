# Runtime environment: development (pretty logs) or production (JSON logs)
NODE_ENV=development
# Port the HTTP server listens on
PORT=3001
# Bearer token clients must send in the Authorization header (required, min 16 chars)
MOCK_API_TOKEN=
# MongoDB connection string (required)
MONGODB_URI=
# MongoDB database name
MONGODB_DB=mock_meta
# Comma-separated ad set ids whose status change is written but then answered with a 500 (e.g. as_lookalike)
FAIL_PAUSE_ADSET_IDS=
