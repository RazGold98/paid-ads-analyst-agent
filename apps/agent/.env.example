# Runtime environment: development (pretty logs) or production (JSON logs)
NODE_ENV=development
# Port the HTTP server listens on
PORT=3000
# Bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=
# Public HTTPS base URL of this service; when set, the bot runs in webhook mode instead of polling
PUBLIC_URL=
# Secret Telegram sends in each webhook request (required when PUBLIC_URL is set; A-Z, a-z, 0-9, _ and -, max 256 chars)
TELEGRAM_WEBHOOK_SECRET=
# Base URL of the mock Meta Ads API (required; a trailing slash is removed), e.g. http://localhost:3001
MOCK_API_URL=
# Bearer token for the mock Meta Ads API; must match its MOCK_API_TOKEN (required, min 16 chars)
MOCK_API_TOKEN=
# Ad account the agent reads from
AD_ACCOUNT_ID=act_1001
# OpenRouter API key for the LLM (required)
OPENROUTER_API_KEY=
# OpenRouter model id; must support tool calling
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# MongoDB connection string for the agent's state: action requests, approvers, audit log (required)
MONGODB_URI=
# Database name inside the cluster (keep it different from the mock's mock_meta)
MONGODB_DB=agent
# Code testers send as "/register <code>" to become approvers (required, min 12 chars, keep secret)
APPROVER_CODE=
