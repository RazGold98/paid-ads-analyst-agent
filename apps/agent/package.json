{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "check:data": "tsx src/scripts/check-data.ts",
    "ask": "tsx src/scripts/ask.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "eval": "tsx src/evals/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pino-pretty": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.2",
    "vitest": "^4.1.12"
  }
}
